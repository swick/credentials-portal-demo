{
    "app-id": "io.github.swick.CredentialsPortalDemo",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "passkey-demo",
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--talk-name=org.freedesktop.portal.Desktop"
    ],
    "modules": [
        {
            "name": "python3-pycparser",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --prefix=/app --no-build-isolation --no-deps pycparser-2.22-py3-none-any.whl"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/13/a3/a812df4e2dd5696d1f351d58b8fe16a405b234ad2886a0dab9183fb78109/pycparser-2.22-py3-none-any.whl",
                    "sha256": "c3702b6d3dd8c7abc1afa565d7e63d53a1d0bd86cdc24edd75470f4de499cfcc"
                }
            ]
        },
        {
            "name": "python3-cffi",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --prefix=/app --no-build-isolation --no-deps cffi-2.1.1-cp314-cp314-manylinux2014_x86_64.manylinux_2_17_x86_64.whl"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/e9/02/4e7d553a7ac4b4238b38b3c1b80d486e9d4436f8d2acbf87a0997fe3f402/cffi-2.1.1-cp314-cp314-manylinux2014_x86_64.manylinux_2_17_x86_64.whl",
                    "sha256": "b0431303acaea1089ad4b3e9ce4e6518193def1118d4073ca848635ee4ea2e96"
                }
            ]
        },
        {
            "name": "python3-cryptography",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --prefix=/app --no-build-isolation --no-deps cryptography-50.0.2-cp311-abi3-manylinux2014_x86_64.manylinux_2_17_x86_64.whl"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/21/69/64cef1f702bf6657e0cc186ed1a2891d50d29fb41586b254e1c07adea261/cryptography-50.0.2-cp311-abi3-manylinux2014_x86_64.manylinux_2_17_x86_64.whl",
                    "sha256": "630ebfea3bf689d075f82316324ff7433dc447fe6bc1bfc76524b74b4a9567d2"
                }
            ]
        },
        {
            "name": "python3-typing-extensions",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --prefix=/app --no-build-isolation --no-deps typing_extensions-4.15.0-py3-none-any.whl"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/18/67/36e9267722cc04a6b9f15c7f3441c2363321a3ea07da7ae0c0707beb2a9c/typing_extensions-4.15.0-py3-none-any.whl",
                    "sha256": "f0fa19c6845758ab08074a0cfa8b7aecb71c999ca73d62883bc25cc018c4e548"
                }
            ]
        },
        {
            "name": "python3-dbus-next",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --prefix=/app --no-build-isolation --no-deps ."
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.pythonhosted.org/packages/source/d/dbus-next/dbus_next-0.2.3.tar.gz",
                    "sha256": "f4eae26909332ada528c0a3549dda8d4f088f9b365153952a408e28023a626a5"
                }
            ]
        },
        {
            "name": "passkey-demo",
            "buildsystem": "simple",
            "build-commands": [
                "blueprint-compiler batch-compile _ui . window.blp",
                "glib-compile-resources --sourcedir=. --sourcedir=_ui resources.gresource.xml --target=resources.gresource",
                "install -Dm755 passkey-demo /app/bin/passkey-demo",
                "install -Dm644 app.py /app/share/passkey-demo/app.py",
                "install -Dm644 cbor.py /app/share/passkey-demo/cbor.py",
                "install -Dm644 util.py /app/share/passkey-demo/util.py",
                "install -Dm644 webauthn.py /app/share/passkey-demo/webauthn.py",
                "install -Dm644 resources.gresource /app/share/passkey-demo/resources.gresource",
                "install -Dm644 org.freedesktop.portal.experimental.Credential.xml /app/share/passkey-demo/org.freedesktop.portal.experimental.Credential.xml",
                "install -Dm644 io.github.swick.CredentialsPortalDemo.desktop /app/share/applications/io.github.swick.CredentialsPortalDemo.desktop"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}
